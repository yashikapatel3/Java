    // ── UPDATE ──
    @PostMapping("/update/{id}")
    public String updateProperty(
            @PathVariable Long id,
            @ModelAttribute propertyDTO dto,
            @RequestParam(required = false) Long categoryId,
            @RequestParam(required = false, name = "files") MultipartFile[] files,
            RedirectAttributes redirectAttributes
    ) {
        PropertyMaster existing = propertyMasterRepo.findById(id)
                .orElseThrow(() -> new RuntimeException("Property not found"));

        // Update common fields
        existing.setDescription(dto.getDescription());
        existing.setLandmark(dto.getLandmark());
        existing.setLocation(dto.getLocation());
        existing.setCity(dto.getCity());
        existing.setPrice(dto.getPrice());
        existing.setPropertyType(dto.getPropertyType());
        existing.setLength(dto.getLength());
        existing.setWidth(dto.getWidth());
        existing.setFloor(dto.getFloor());
        existing.setSecurityDeposit(dto.getSecurityDeposit());
        existing.setDuration(dto.getDuration());
        existing.setDirection(dto.getDirection());
        existing.setPostDate(dto.getPostDate());

        // FIX: Yeh fields update mein bhi sahi se set ho rahe hain
        existing.setEletricity(dto.isEletricity());
        existing.setWaterSupply(dto.isWaterSupply());
        existing.setNegotiable(dto.isNegotiable());
        existing.setStatus(dto.isStatus());
        existing.setParking(dto.isParking());

        if (dto.getListingType() != null && !dto.getListingType().isEmpty()) {
            try {
                existing.setListingType(PropertyMaster.ListingType
                        .valueOf(dto.getListingType().toUpperCase().trim()));
            } catch (IllegalArgumentException ignored) {}
        }

        if (categoryId != null) {
            CategoryMaster cat = categoryMasterRepo.findById(categoryId).orElse(null);
            existing.setCategory(cat);
        }

        propertyMasterRepo.save(existing);

        updateResidentialOrCommercial(dto, existing);
        updateAmenities(dto, existing);
        saveMedia(files, existing);

        redirectAttributes.addFlashAttribute("updated", true);
        redirectAttributes.addFlashAttribute("updatedPropertyName", dto.getPropertyType());
        return "redirect:/properties";
    }

    // ── DELETE ──
    @Transactional
    @PostMapping("/delete/{id}")
    public String deleteProperty(@PathVariable Long id, RedirectAttributes redirectAttributes) {
        PropertyMaster property = propertyMasterRepo.findById(id)
                .orElseThrow(() -> new RuntimeException("Property not found: " + id));

        Long propertyId = property.getPropertyId();

        if (property.getMedia() != null)
            mediaMasterRepo.deleteAll(property.getMedia());

        if (property.getAmenities() != null)
            amenitiesRepo.delete(property.getAmenities());

        if (property.getResidenceId() != null)
            residentialRepo.delete(property.getResidenceId());

        if (property.getCommercialId() != null)
            commercialRepo.delete(property.getCommercialId());

        propertyMasterRepo.deleteById(id);

        redirectAttributes.addFlashAttribute("deleted", true);
        redirectAttributes.addFlashAttribute("deletedPropertyId", propertyId);
        return "redirect:/properties";
    }

    @GetMapping("/property/{id}")
    public String showPropertyDetail(@PathVariable Long id, Model model) {
        PropertyMaster property = propertyMasterRepo.findById(id)
                .orElseThrow(() -> new RuntimeException("Property not found: " + id));

        String mediaUrl = "";
        if (property.getMedia() != null && !property.getMedia().isEmpty()) {
            mediaUrl = property.getMedia().get(0).getFileURL();
        }

        PropertyResponseDTO dto = convertToDTO(property);
        model.addAttribute("property", dto);
        return "propertydetail";
    }

    // ── PRIVATE HELPERS ──

    private PropertyMaster convertToEntity(propertyDTO dto, Long categoryId) {
        PropertyMaster p = new PropertyMaster();

        p.setDescription(dto.getDescription());
        p.setLandmark(dto.getLandmark());
        p.setLocation(dto.getLocation());
        p.setCity(dto.getCity());
        p.setPrice(dto.getPrice());
        p.setSecurityDeposit(dto.getSecurityDeposit());
        p.setPropertyType(dto.getPropertyType());
        p.setLength(dto.getLength());
        p.setWidth(dto.getWidth());
        p.setFloor(dto.getFloor());
        p.setDuration(dto.getDuration());
        p.setDirection(dto.getDirection());
        p.setPostDate(dto.getPostDate());

        // FIX: Yeh 5 fields pehle MISSING the convertToEntity mein — ab add kiye
        p.setEletricity(dto.isEletricity());
        p.setWaterSupply(dto.isWaterSupply());
        p.setNegotiable(dto.isNegotiable());
        p.setStatus(dto.isStatus());
        p.setParking(dto.isParking());  // FIX: amenitiesParking ki jagah parking use kiya

        if (dto.getListingType() != null && !dto.getListingType().isEmpty()) {
            try {
                p.setListingType(PropertyMaster.ListingType
                        .valueOf(dto.getListingType().toUpperCase().trim()));
            } catch (IllegalArgumentException e) {
                p.setListingType(PropertyMaster.ListingType.RENT);
            }
        }

        if (categoryId != null) {
            CategoryMaster cat = categoryMasterRepo.findById(categoryId).orElse(null);
            p.setCategory(cat);
        }

        return p;
    }

    private static final java.util.Set<String> RESIDENTIAL_TYPES = java.util.Set.of(
            "house", "flat", "villa", "building", "pg", "other"
    );
    private static final java.util.Set<String> COMMERCIAL_TYPES = java.util.Set.of(
            "shop", "office", "warehouse", "cold storage", "showroom", "plot/land", "other"
    );

    private void saveResidentialOrCommercial(propertyDTO dto, PropertyMaster property) {
        String type = dto.getPropertyType();
        if (type == null) return;

        String typeLower = type.toLowerCase().trim();

        if (RESIDENTIAL_TYPES.contains(typeLower)) {
            Residential_PropertyMaster res = new Residential_PropertyMaster();
            res.setNoOFroom(dto.getNoOfRoom());
            res.setNoOFmember(dto.getNoOfMember());
            res.setBhk(dto.getBhk());

            String fs = dto.getFurnishedStatus();
            res.setFurnished(fs != null && !fs.equalsIgnoreCase("Unfurnished"));

            res.setProperty(property);
            property.setResidenceId(res);
            propertyMasterRepo.save(property);

        } else if (COMMERCIAL_TYPES.contains(typeLower)) {
            Commercial_PropertyMaster com = new Commercial_PropertyMaster();
            com.setProperty(property);
            property.setCommercialId(com);
            propertyMasterRepo.save(property);
        }
    }

    private void updateResidentialOrCommercial(propertyDTO dto, PropertyMaster property) {
        String type = dto.getPropertyType();
        if (type == null) return;

        String typeLower = type.toLowerCase().trim();

        if (RESIDENTIAL_TYPES.contains(typeLower)) {
            Residential_PropertyMaster res = property.getResidenceId();
            if (res == null) res = new Residential_PropertyMaster();

            res.setNoOFroom(dto.getNoOfRoom());
            res.setNoOFmember(dto.getNoOfMember());
            res.setBhk(dto.getBhk());

            String fs = dto.getFurnishedStatus();
            res.setFurnished(fs != null && !fs.equalsIgnoreCase("Unfurnished"));

            res.setProperty(property);
            residentialRepo.save(res);

        } else if (COMMERCIAL_TYPES.contains(typeLower)) {
            if (property.getCommercialId() == null) {
                Commercial_PropertyMaster com = new Commercial_PropertyMaster();
                com.setProperty(property);
                commercialRepo.save(com);
            }
        }
    }

    private void saveAmenities(propertyDTO dto, PropertyMaster property) {
        AmenitiesMaster am = new AmenitiesMaster();
        am.setParking(dto.isAmenitiesParking());
        am.setSecurity(dto.isAmenitiesSecurity());
        am.setLift(dto.isAmenitiesLift());
        am.setGarden(dto.isAmenitiesGarden());
        am.setWifi(dto.isAmenitiesWifi());
        am.setAttachedBathroom(dto.isAmenitiesAttachedBathroom());
        am.setTerrace(dto.isAmenitiesTerrace());
        am.setProperty(property);
        amenitiesRepo.save(am);
    }

    private void updateAmenities(propertyDTO dto, PropertyMaster property) {
        AmenitiesMaster am = property.getAmenities();
        if (am == null) am = new AmenitiesMaster();
        am.setParking(dto.isAmenitiesParking());
        am.setSecurity(dto.isAmenitiesSecurity());
        am.setLift(dto.isAmenitiesLift());
        am.setGarden(dto.isAmenitiesGarden());
        am.setWifi(dto.isAmenitiesWifi());
        am.setAttachedBathroom(dto.isAmenitiesAttachedBathroom());
        am.setTerrace(dto.isAmenitiesTerrace());
        am.setProperty(property);
        amenitiesRepo.save(am);
    }

    private void saveMedia(MultipartFile[] files, PropertyMaster property) {
        if (files == null) return;

        for (int i = 0; i < files.length; i++) {
            MultipartFile file = files[i];
            if (file == null || file.isEmpty()) continue;

            try {
                String contentType = file.getContentType();

                FileStorageService.PropertyFolder folder;
                MediaMaster.MediaType mediaType;

                if (contentType != null && contentType.startsWith("image")) {
                    folder = FileStorageService.PropertyFolder.PROPERTY_IMAGE;
                    mediaType = MediaMaster.MediaType.IMAGE;
                } else if (contentType != null && contentType.startsWith("video")) {
                    folder = FileStorageService.PropertyFolder.PROPERTY_VIDEO;
                    mediaType = MediaMaster.MediaType.VIDEO;
                } else {
                    throw new RuntimeException("Unsupported file type");
                }

                String url = fileStorageService.savePropertyFiles(file, folder);
                System.out.println(">>> SAVED URL: " + url);

                MediaMaster media = new MediaMaster();
                media.setFileURL(url);
                media.setFileName(file.getOriginalFilename());
                media.setPostedOn(LocalDate.now());
                media.setProperty(property);
                media.setMediaType(mediaType);
                media.isPrimary();

                mediaMasterRepo.save(media);

            } catch (Exception e) {
                e.printStackTrace();
            }
        }
    }

    private PropertyResponseDTO convertToDTO(PropertyMaster p) {
        return new PropertyResponseDTO(p);
    }
